DATABASE_URL="postgresql://prisma:prisma@localhost:5432/projeto_prisma?schema=public"
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
JWT_SECRET=troque-por-um-segredo-forte-em-producao

# Lista separada por vírgula das origens de navegador autorizadas a chamar a
# API (ex.: https://app.suabarbearia.com,https://admin.suabarbearia.com).
# Sem isso definido em produção, CORS bloqueia todas as origens por padrão.
# Em dev, se deixar vazio, libera qualquer localhost/127.0.0.1 automaticamente.
# CORS_ORIGINS=https://app.suabarbearia.com,https://admin.suabarbearia.com

# Notificações por e-mail (Resend — https://resend.com/api-keys). Sem chave
# configurada, notificações de e-mail ficam FAILED (o servidor sobe normal;
# só o WhatsApp continua entregando via n8n).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Sua Barbearia <onboarding@resend.dev>"
SHOP_NAME="Sua Barbearia"

# Ainda não existe painel administrativo com URL própria (API-first). Sem
# isso definido, o e-mail de "esqueci minha senha" mostra o token cru em
# vez de um link — ver README §Recuperação de senha de equipe.
# ADMIN_PANEL_URL=https://admin.suabarbearia.com

# --- WhatsApp via n8n + Evolution API (opcional — só pro perfil "whatsapp" ---
# --- do docker-compose.yml; a API em si não usa nenhuma destas). Ver     ---
# --- n8n/README.md pro passo a passo completo.                          ---
# N8N_ENCRYPTION_KEY=  # gerar uma vez com `openssl rand -hex 24` e nunca trocar
# EVOLUTION_API_KEY=   # qualquer string forte — é a "senha" da API do Evolution
# EVOLUTION_INSTANCE=barbearia
# PRISMA_API_URL=http://host.docker.internal:3000
# PRISMA_WEBHOOK_SECRET=  # o "secret" que POST /webhook-endpoints devolveu
# PRISMA_API_KEY=         # sk_... de uma API key com os escopos certos (ver n8n/README.md)
