PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
JWT_SECRET=troque-por-um-segredo-forte-em-producao

# Lista separada por vírgula das origens de navegador autorizadas a chamar a
# API (ex.: https://app.suabarbearia.com,https://admin.suabarbearia.com).
# Sem isso definido em produção, CORS bloqueia todas as origens por padrão.
# Em dev, se deixar vazio, libera qualquer localhost/127.0.0.1 automaticamente.
# CORS_ORIGINS=https://app.suabarbearia.com,https://admin.suabarbearia.com
