// Projeto Prisma — schema de dados
// Escopo desta etapa: fundação (identidade + catálogo) e motor de agenda.
// Ver docs/ARQUITETURA.md para o desenho completo (todas as fases).

generator client {
  provider      = "prisma-client-js"
  // node:22-alpine já traz libssl.so.3 (Alpine 3.24), mas o Prisma não
  // consegue detectar a versão do OpenSSL dentro da imagem (sem o binário
  // `openssl`) e cairia no engine errado (openssl-1.1.x) por padrão —
  // declarar o target explicitamente evita esse mismatch em runtime.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identidade
// ---------------------------------------------------------------------------

enum UserRole {
  CLIENT
  BARBER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String     @id @default(cuid())
  shopId       String     @default("default") @map("shop_id")
  email        String?    @unique
  phone        String     @unique
  passwordHash String?    @map("password_hash")
  role         UserRole
  status       UserStatus @default(ACTIVE)
  // Bloqueio de conta por tentativa de senha errada (login de equipe) —
  // camada complementar ao rate limit por IP: pega o ataque lento/distribuído
  // contra UMA conta específica, que o limite por IP não enxerga.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  client  Client?
  barber  Barber?
  refreshTokens RefreshToken[]

  @@index([shopId])
  @@map("users")
}

// Sessão de equipe com rotação: cada uso troca o token por um novo e
// revoga o anterior (replacedById encadeia o histórico). Reapresentar um
// token já revogado é sinal de roubo — vira gatilho para revogar todos os
// tokens ativos do usuário (ver staff-auth.service.ts).
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Client {
  id                 String   @id @default(cuid())
  shopId             String   @default("default") @map("shop_id")
  userId             String   @unique @map("user_id")
  // Opcional: o primeiro login (OTP) cria o Client antes do cadastro estar
  // completo — o app pede o nome depois via PATCH /me.
  fullName           String?  @map("full_name")
  birthDate          DateTime? @map("birth_date") @db.Date
  preferredBarberId  String?  @map("preferred_barber_id")
  allergyNotes       String?  @map("allergy_notes")
  hairNotes          String?  @map("hair_notes")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredBarber Barber?   @relation("PreferredBarber", fields: [preferredBarberId], references: [id])
  appointments    Appointment[]
  notifications   Notification[]
  clientPackages  ClientPackage[]
  loyaltyEntries  LoyaltyEntry[]
  orders          Order[]
  reviews         Review[]

  @@index([shopId])
  @@map("clients")
}

enum BarberStatus {
  ACTIVE
  INACTIVE
}

model Barber {
  id             String       @id @default(cuid())
  shopId         String       @default("default") @map("shop_id")
  userId         String       @unique @map("user_id")
  displayName    String       @map("display_name")
  photoUrl       String?      @map("photo_url")
  bio            String?
  commissionPct  Decimal?     @map("commission_pct") @db.Decimal(5, 2)
  status         BarberStatus @default(ACTIVE)
  hiredAt        DateTime?    @map("hired_at") @db.Date
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  services           BarberService[]
  workSchedules      WorkSchedule[]
  scheduleExceptions ScheduleException[]
  appointments       Appointment[]
  preferredByClients Client[]           @relation("PreferredBarber")
  reviews            Review[]

  @@index([shopId])
  @@map("barbers")
}

model ShopSettings {
  id                        String   @id @default(cuid())
  shopId                    String   @unique @default("default") @map("shop_id")
  timezone                  String   @default("America/Sao_Paulo")
  slotStepMin               Int      @default(15) @map("slot_step_min")
  minLeadTimeMin            Int      @default(60) @map("min_lead_time_min")
  maxAdvanceDays            Int      @default(60) @map("max_advance_days")
  cancelDeadlineHours       Int      @default(2) @map("cancel_deadline_hours")
  rescheduleDeadlineHours   Int      @default(2) @map("reschedule_deadline_hours")
  autoConfirmHoursBefore    Int      @default(24) @map("auto_confirm_hours_before")
  loyaltyPointsPerCurrency  Decimal  @default(1.00) @map("loyalty_points_per_currency") @db.Decimal(6, 2)
  loyaltyPointValueCents    Int      @default(5) @map("loyalty_point_value_cents")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("shop_settings")
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

model ServiceCategory {
  id        String    @id @default(cuid())
  shopId    String    @default("default") @map("shop_id")
  name      String
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  services  Service[]

  @@index([shopId])
  @@map("service_categories")
}

model Service {
  id               String   @id @default(cuid())
  shopId           String   @default("default") @map("shop_id")
  categoryId       String   @map("category_id")
  name             String
  description      String?
  durationMin      Int      @map("duration_min")
  bufferAfterMin   Int      @default(0) @map("buffer_after_min")
  priceCents       Int      @map("price_cents")
  active           Boolean  @default(true)
  onlineBookable   Boolean  @default(true) @map("online_bookable")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category         ServiceCategory   @relation(fields: [categoryId], references: [id])
  barberServices   BarberService[]
  appointmentItems AppointmentItem[]

  @@index([shopId])
  @@index([categoryId])
  @@map("services")
}

model BarberService {
  barberId            String   @map("barber_id")
  serviceId           String   @map("service_id")
  durationOverrideMin Int?     @map("duration_override_min")
  priceOverrideCents  Int?     @map("price_override_cents")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@map("barber_services")
}

// ---------------------------------------------------------------------------
// Agenda
// ---------------------------------------------------------------------------

// weekday: 0 = domingo ... 6 = sábado (convenção do próprio banco/ISO adaptada)
model WorkSchedule {
  id          String    @id @default(cuid())
  shopId      String    @default("default") @map("shop_id")
  barberId    String    @map("barber_id")
  weekday     Int
  startTime   DateTime  @map("start_time") @db.Time()
  endTime     DateTime  @map("end_time") @db.Time()
  validFrom   DateTime  @default(now()) @map("valid_from") @db.Date
  validUntil  DateTime? @map("valid_until") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([barberId, weekday])
  @@map("work_schedules")
}

enum ScheduleExceptionType {
  TIME_OFF
  HOLIDAY
  MANUAL_BLOCK
}

// barberId nulo = afeta a loja inteira (feriado)
model ScheduleException {
  id        String                 @id @default(cuid())
  shopId    String                 @default("default") @map("shop_id")
  barberId  String?                @map("barber_id")
  startsAt  DateTime               @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime               @map("ends_at") @db.Timestamptz(3)
  type      ScheduleExceptionType
  reason    String?
  allDay    Boolean                @default(false) @map("all_day")
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  barber Barber? @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([barberId, startsAt])
  @@map("schedule_exceptions")
}

enum AppointmentKind {
  SERVICE
  BLOCK
}

enum AppointmentStatus {
  PENDENTE_PAGAMENTO
  AGENDADO
  CONFIRMADO
  EM_ATENDIMENTO
  CONCLUIDO
  CANCELADO
  NAO_COMPARECEU
}

enum AppointmentSource {
  PORTAL
  ADMIN
  WHATSAPP
  API
}

model Appointment {
  id              String            @id @default(cuid())
  shopId          String            @default("default") @map("shop_id")
  code            String            @unique
  kind            AppointmentKind   @default(SERVICE)
  clientId        String?           @map("client_id")
  barberId        String            @map("barber_id")
  startsAt        DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime          @map("ends_at") @db.Timestamptz(3)
  serviceEndsAt   DateTime?         @map("service_ends_at") @db.Timestamptz(3)
  status          AppointmentStatus @default(AGENDADO)
  totalPriceCents Int               @default(0) @map("total_price_cents")
  clientNotes     String?           @map("client_notes")
  internalNotes   String?           @map("internal_notes")
  source          AppointmentSource @default(PORTAL)
  holdExpiresAt   DateTime?         @map("hold_expires_at") @db.Timestamptz(3)
  cancelledAt     DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancelReason    String?           @map("cancel_reason")
  cancelledBy     String?           @map("cancelled_by")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Coluna gerada + constraint de exclusão são adicionadas via SQL manual
  // na migração 20260814094718 (Prisma não modela tstzrange / EXCLUDE
  // nativamente). Declarada como Unsupported para o client saber que ela
  // existe, sem tentar escrevê-la.
  timeRange Unsupported("tstzrange")? @map("time_range")

  client Client? @relation(fields: [clientId], references: [id])
  barber Barber  @relation(fields: [barberId], references: [id])
  items  AppointmentItem[]
  statusHistory AppointmentStatusHistory[]
  payments      Payment[]
  packageCreditEntries PackageCreditEntry[]
  orders        Order[]
  review        Review?

  @@index([shopId])
  @@index([barberId, startsAt])
  @@index([clientId, startsAt])
  @@index([status, startsAt])
  @@map("appointments")
}

enum ActorType {
  CLIENT
  BARBER
  ADMIN
  SYSTEM
  API
}

// Trilha de auditoria: quem mudou o status de qual agendamento, quando e por quê.
model AppointmentStatusHistory {
  id            String             @id @default(cuid())
  appointmentId String             @map("appointment_id")
  fromStatus    AppointmentStatus? @map("from_status")
  toStatus      AppointmentStatus  @map("to_status")
  actorType     ActorType          @map("actor_type")
  actorId       String?            @map("actor_id")
  reason        String?
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@map("appointment_status_history")
}

model AppointmentItem {
  id             String  @id @default(cuid())
  appointmentId  String  @map("appointment_id")
  serviceId      String  @map("service_id")
  nameSnapshot   String  @map("name_snapshot")
  durationMin    Int     @map("duration_min")
  priceCents     Int     @map("price_cents")
  position       Int     @default(0)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@index([appointmentId])
  @@map("appointment_items")
}

// ---------------------------------------------------------------------------
// Integração — outbox transacional + webhooks (n8n e afins)
// ---------------------------------------------------------------------------

// Padrão outbox: o evento é gravado NA MESMA transação da mudança que o
// originou. Ou os dois existem, ou nenhum — nunca "mudou mas não avisou".
model OutboxEvent {
  id            String    @id @default(cuid())
  shopId        String    @default("default") @map("shop_id")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  payload       Json
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)

  deliveries WebhookDelivery[]

  @@index([shopId, occurredAt])
  @@index([publishedAt])
  @@index([eventType, occurredAt])
  @@map("outbox_events")
}

model WebhookEndpoint {
  id                  String   @id @default(cuid())
  shopId              String   @default("default") @map("shop_id")
  url                 String
  secret              String
  subscribedEvents    String[] @map("subscribed_events")
  active              Boolean  @default(true)
  consecutiveFailures Int      @default(0) @map("consecutive_failures")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  deliveries WebhookDelivery[]

  @@index([shopId])
  @@map("webhook_endpoints")
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
  ABANDONED
}

model WebhookDelivery {
  id                String                @id @default(cuid())
  outboxEventId     String                @map("outbox_event_id")
  webhookEndpointId String                @map("webhook_endpoint_id")
  status            WebhookDeliveryStatus @default(PENDING)
  responseCode      Int?                  @map("response_code")
  attempts          Int                   @default(0)
  nextRetryAt       DateTime              @map("next_retry_at") @db.Timestamptz(3)
  lastAttemptAt     DateTime?             @map("last_attempt_at") @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  outboxEvent     OutboxEvent     @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)
  webhookEndpoint WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([outboxEventId])
  @@map("webhook_deliveries")
}

// ---------------------------------------------------------------------------
// Notificações agendadas + autenticação do portal (OTP)
// ---------------------------------------------------------------------------

enum NotificationChannel {
  WHATSAPP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  CANCELLED
  FAILED
}

// scheduled_for materializa o lembrete como uma linha FUTURA — o worker só
// varre scheduled_for <= now(). "SENT" aqui significa "entregue ao pipeline
// de webhooks" (emitimos um outbox_event notification.due); a confirmação de
// entrega real pelo WhatsApp/e-mail é reportada de volta via PATCH
// /notifications/:id, preenchendo provider_message_id.
model Notification {
  id                String              @id @default(cuid())
  shopId            String              @default("default") @map("shop_id")
  clientId          String?             @map("client_id")
  channel           NotificationChannel
  template          String
  payload           Json
  scheduledFor      DateTime            @map("scheduled_for") @db.Timestamptz(3)
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(3)
  status            NotificationStatus  @default(PENDING)
  providerMessageId String?             @map("provider_message_id")
  dedupKey          String              @unique @map("dedup_key")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  client Client? @relation(fields: [clientId], references: [id])

  @@index([status, scheduledFor])
  @@index([shopId])
  @@map("notifications")
}

// Códigos de uso único para login por telefone. `attempts` limita
// tentativas de adivinhação; `consumedAt` impede reuso do mesmo código.
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  code       String
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@map("otp_codes")
}

// ---------------------------------------------------------------------------
// Pagamentos, pacotes e fidelidade
// ---------------------------------------------------------------------------
//
// Não há gateway de pagamento integrado: todo Payment aqui representa
// dinheiro que o balcão já recebeu (dinheiro/cartão/pix) ou crédito de
// pacote já consumido — é registro, não processamento de cobrança.
//
// Crédito de pacote é debitado só na CONCLUSÃO do atendimento (não na
// criação), então cancelar um agendamento nunca precisa estornar crédito —
// ele nunca chegou a ser debitado.

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
  PACKAGE
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

// Três FKs opcionais + CHECK de exatamente uma preenchida (migração manual,
// mesmo padrão da constraint de exclusão de appointments): dá pra saber de
// onde veio o dinheiro sem um polimórfico (payable_type, payable_id).
model Payment {
  id              String        @id @default(cuid())
  shopId          String        @default("default") @map("shop_id")
  appointmentId   String?       @map("appointment_id")
  clientPackageId String?       @map("client_package_id")
  orderId         String?       @map("order_id")
  amountCents     Int           @map("amount_cents")
  method          PaymentMethod
  status          PaymentStatus @default(PAID)
  paidAt          DateTime?     @map("paid_at") @db.Timestamptz(3)
  externalId      String?       @map("external_id")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  clientPackage ClientPackage? @relation(fields: [clientPackageId], references: [id])
  order         Order?         @relation(fields: [orderId], references: [id])

  @@index([appointmentId])
  @@index([clientPackageId])
  @@index([orderId])
  @@index([shopId, createdAt])
  @@map("payments")
}

model Package {
  id              String   @id @default(cuid())
  shopId          String   @default("default") @map("shop_id")
  name            String
  description     String?
  priceCents      Int      @map("price_cents")
  creditsQty      Int      @map("credits_qty")
  // vazio = vale para qualquer serviço; senão, só para os serviços listados
  scopeServiceIds String[] @map("scope_service_ids")
  validityDays    Int      @map("validity_days")
  isRecurring     Boolean  @default(false) @map("is_recurring")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  clientPackages ClientPackage[]

  @@index([shopId])
  @@map("packages")
}

enum ClientPackageStatus {
  ACTIVE
  CANCELLED
}

// Saldo de créditos = creditsTotal + SUM(creditEntries.delta) — nunca um
// contador solto (mesma razão de ledger usada em fidelidade).
model ClientPackage {
  id           String              @id @default(cuid())
  shopId       String              @default("default") @map("shop_id")
  clientId     String              @map("client_id")
  packageId    String              @map("package_id")
  purchasedAt  DateTime            @default(now()) @map("purchased_at") @db.Timestamptz(3)
  expiresAt    DateTime            @map("expires_at") @db.Timestamptz(3)
  creditsTotal Int                 @map("credits_total")
  status       ClientPackageStatus @default(ACTIVE)

  client        Client               @relation(fields: [clientId], references: [id])
  package       Package              @relation(fields: [packageId], references: [id])
  creditEntries PackageCreditEntry[]
  payments      Payment[]

  @@index([clientId])
  @@index([shopId])
  @@map("client_packages")
}

model PackageCreditEntry {
  id              String   @id @default(cuid())
  clientPackageId String   @map("client_package_id")
  appointmentId   String?  @map("appointment_id")
  delta           Int
  reason          String
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  clientPackage ClientPackage @relation(fields: [clientPackageId], references: [id], onDelete: Cascade)
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])

  @@index([clientPackageId])
  @@map("package_credit_entries")
}

enum LoyaltyReason {
  EARN
  REDEEM
  ADJUST
}

// Saldo = SUM(deltaPoints) — mesmo motivo do ledger de pacotes: um campo de
// saldo isolado desanda no primeiro bug de concorrência.
model LoyaltyEntry {
  id          String        @id @default(cuid())
  shopId      String        @default("default") @map("shop_id")
  clientId    String        @map("client_id")
  deltaPoints Int           @map("delta_points")
  reason      LoyaltyReason
  refType     String?       @map("ref_type")
  refId       String?       @map("ref_id")
  expiresAt   DateTime?     @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  client Client @relation(fields: [clientId], references: [id])

  @@index([clientId, createdAt])
  @@index([shopId])
  @@map("loyalty_entries")
}

// ---------------------------------------------------------------------------
// Mini e-commerce (loja integrada)
// ---------------------------------------------------------------------------
//
// stockQty é cache de SUM(stock_movements.delta), atualizado na MESMA
// transação de cada movimento — nunca escrito solto. Débito por venda usa
// SELECT ... FOR UPDATE (mesmo raciocínio do crédito de pacote) para duas
// vendas simultâneas da última unidade não venderem em dobro.

model Product {
  id             String   @id @default(cuid())
  shopId         String   @default("default") @map("shop_id")
  sku            String?  @unique
  name           String
  description    String?
  specs          Json?
  costPriceCents Int      @map("cost_price_cents")
  salePriceCents Int      @map("sale_price_cents")
  stockQty       Int      @default(0) @map("stock_qty")
  minStock       Int      @default(0) @map("min_stock")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  images         ProductImage[]
  stockMovements StockMovement[]
  orderItems     OrderItem[]

  @@index([shopId])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

enum StockMovementReason {
  PURCHASE_IN
  SALE
  ADJUSTMENT
  LOSS
  RETURN
}

model StockMovement {
  id        String               @id @default(cuid())
  productId String               @map("product_id")
  delta     Int
  reason    StockMovementReason
  refType   String?              @map("ref_type")
  refId     String?              @map("ref_id")
  notes     String?
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, createdAt])
  @@map("stock_movements")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

// appointmentId é opcional: dá pra vender produto avulso no balcão ou
// vinculado à visita de um atendimento (mesmo raciocínio do doc original).
model Order {
  id            String      @id @default(cuid())
  shopId        String      @default("default") @map("shop_id")
  clientId      String?     @map("client_id")
  appointmentId String?     @map("appointment_id")
  status        OrderStatus @default(PAID)
  totalCents    Int         @map("total_cents")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  client      Client?      @relation(fields: [clientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  items       OrderItem[]
  payments    Payment[]

  @@index([clientId])
  @@index([shopId, createdAt])
  @@map("orders")
}

// Preço E custo congelados na venda — reajuste de tabela depois não pode
// reescrever a margem do que já foi vendido (mesma decisão de
// appointment_items para serviços).
model OrderItem {
  id            String @id @default(cuid())
  orderId       String @map("order_id")
  productId     String @map("product_id")
  qty           Int
  unitPriceCents Int   @map("unit_price_cents")
  unitCostCents  Int   @map("unit_cost_cents")
  position      Int    @default(0)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Avaliações
// ---------------------------------------------------------------------------

// Uma avaliação por atendimento (não por barbeiro) — é isso que permite
// liberar o review só depois de CONCLUIDO, e evita nota "solta" sem visita.
model Review {
  id            String   @id @default(cuid())
  shopId        String   @default("default") @map("shop_id")
  appointmentId String   @unique @map("appointment_id")
  clientId      String   @map("client_id")
  barberId      String   @map("barber_id")
  rating        Int
  comment       String?
  publishedAt   DateTime @default(now()) @map("published_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  client      Client      @relation(fields: [clientId], references: [id])
  barber      Barber      @relation(fields: [barberId], references: [id])

  @@index([barberId])
  @@index([shopId])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// API keys (máquinas — n8n e outros consumidores server-to-server)
// ---------------------------------------------------------------------------

// keyHash é o que autentica (sha256 da chave sk_... inteira); keyPrefix é só
// os primeiros caracteres, guardados em claro para o admin reconhecer qual
// chave é qual numa listagem sem nunca poder ver o segredo de novo — mesmo
// raciocínio de "últimos 4 dígitos" de cartão.
model ApiKey {
  id         String    @id @default(cuid())
  shopId     String    @default("default") @map("shop_id")
  name       String
  keyPrefix  String    @map("key_prefix")
  keyHash    String    @unique @map("key_hash")
  scopes     String[]
  active     Boolean   @default(true)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([shopId])
  @@map("api_keys")
}
