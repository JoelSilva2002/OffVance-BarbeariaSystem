// Projeto Prisma — schema de dados
// Escopo desta etapa: fundação (identidade + catálogo) e motor de agenda.
// Ver docs/ARQUITETURA.md para o desenho completo (todas as fases).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identidade
// ---------------------------------------------------------------------------

enum UserRole {
  CLIENT
  BARBER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String     @id @default(cuid())
  shopId       String     @default("default") @map("shop_id")
  email        String?    @unique
  phone        String     @unique
  passwordHash String?    @map("password_hash")
  role         UserRole
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  client  Client?
  barber  Barber?

  @@index([shopId])
  @@map("users")
}

model Client {
  id                 String   @id @default(cuid())
  shopId             String   @default("default") @map("shop_id")
  userId             String   @unique @map("user_id")
  // Opcional: o primeiro login (OTP) cria o Client antes do cadastro estar
  // completo — o app pede o nome depois via PATCH /me.
  fullName           String?  @map("full_name")
  birthDate          DateTime? @map("birth_date") @db.Date
  preferredBarberId  String?  @map("preferred_barber_id")
  allergyNotes       String?  @map("allergy_notes")
  hairNotes          String?  @map("hair_notes")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredBarber Barber?   @relation("PreferredBarber", fields: [preferredBarberId], references: [id])
  appointments    Appointment[]
  notifications   Notification[]

  @@index([shopId])
  @@map("clients")
}

enum BarberStatus {
  ACTIVE
  INACTIVE
}

model Barber {
  id             String       @id @default(cuid())
  shopId         String       @default("default") @map("shop_id")
  userId         String       @unique @map("user_id")
  displayName    String       @map("display_name")
  photoUrl       String?      @map("photo_url")
  bio            String?
  commissionPct  Decimal?     @map("commission_pct") @db.Decimal(5, 2)
  status         BarberStatus @default(ACTIVE)
  hiredAt        DateTime?    @map("hired_at") @db.Date
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  services           BarberService[]
  workSchedules      WorkSchedule[]
  scheduleExceptions ScheduleException[]
  appointments       Appointment[]
  preferredByClients Client[]           @relation("PreferredBarber")

  @@index([shopId])
  @@map("barbers")
}

model ShopSettings {
  id                        String   @id @default(cuid())
  shopId                    String   @unique @default("default") @map("shop_id")
  timezone                  String   @default("America/Sao_Paulo")
  slotStepMin               Int      @default(15) @map("slot_step_min")
  minLeadTimeMin            Int      @default(60) @map("min_lead_time_min")
  maxAdvanceDays            Int      @default(60) @map("max_advance_days")
  cancelDeadlineHours       Int      @default(2) @map("cancel_deadline_hours")
  rescheduleDeadlineHours   Int      @default(2) @map("reschedule_deadline_hours")
  autoConfirmHoursBefore    Int      @default(24) @map("auto_confirm_hours_before")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("shop_settings")
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

model ServiceCategory {
  id        String    @id @default(cuid())
  shopId    String    @default("default") @map("shop_id")
  name      String
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  services  Service[]

  @@index([shopId])
  @@map("service_categories")
}

model Service {
  id               String   @id @default(cuid())
  shopId           String   @default("default") @map("shop_id")
  categoryId       String   @map("category_id")
  name             String
  description      String?
  durationMin      Int      @map("duration_min")
  bufferAfterMin   Int      @default(0) @map("buffer_after_min")
  priceCents       Int      @map("price_cents")
  active           Boolean  @default(true)
  onlineBookable   Boolean  @default(true) @map("online_bookable")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category         ServiceCategory   @relation(fields: [categoryId], references: [id])
  barberServices   BarberService[]
  appointmentItems AppointmentItem[]

  @@index([shopId])
  @@index([categoryId])
  @@map("services")
}

model BarberService {
  barberId            String   @map("barber_id")
  serviceId           String   @map("service_id")
  durationOverrideMin Int?     @map("duration_override_min")
  priceOverrideCents  Int?     @map("price_override_cents")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@map("barber_services")
}

// ---------------------------------------------------------------------------
// Agenda
// ---------------------------------------------------------------------------

// weekday: 0 = domingo ... 6 = sábado (convenção do próprio banco/ISO adaptada)
model WorkSchedule {
  id          String    @id @default(cuid())
  shopId      String    @default("default") @map("shop_id")
  barberId    String    @map("barber_id")
  weekday     Int
  startTime   DateTime  @map("start_time") @db.Time()
  endTime     DateTime  @map("end_time") @db.Time()
  validFrom   DateTime  @default(now()) @map("valid_from") @db.Date
  validUntil  DateTime? @map("valid_until") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([barberId, weekday])
  @@map("work_schedules")
}

enum ScheduleExceptionType {
  TIME_OFF
  HOLIDAY
  MANUAL_BLOCK
}

// barberId nulo = afeta a loja inteira (feriado)
model ScheduleException {
  id        String                 @id @default(cuid())
  shopId    String                 @default("default") @map("shop_id")
  barberId  String?                @map("barber_id")
  startsAt  DateTime               @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime               @map("ends_at") @db.Timestamptz(3)
  type      ScheduleExceptionType
  reason    String?
  allDay    Boolean                @default(false) @map("all_day")
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  barber Barber? @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([barberId, startsAt])
  @@map("schedule_exceptions")
}

enum AppointmentKind {
  SERVICE
  BLOCK
}

enum AppointmentStatus {
  PENDENTE_PAGAMENTO
  AGENDADO
  CONFIRMADO
  EM_ATENDIMENTO
  CONCLUIDO
  CANCELADO
  NAO_COMPARECEU
}

enum AppointmentSource {
  PORTAL
  ADMIN
  WHATSAPP
  API
}

model Appointment {
  id              String            @id @default(cuid())
  shopId          String            @default("default") @map("shop_id")
  code            String            @unique
  kind            AppointmentKind   @default(SERVICE)
  clientId        String?           @map("client_id")
  barberId        String            @map("barber_id")
  startsAt        DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime          @map("ends_at") @db.Timestamptz(3)
  serviceEndsAt   DateTime?         @map("service_ends_at") @db.Timestamptz(3)
  status          AppointmentStatus @default(AGENDADO)
  totalPriceCents Int               @default(0) @map("total_price_cents")
  clientNotes     String?           @map("client_notes")
  internalNotes   String?           @map("internal_notes")
  source          AppointmentSource @default(PORTAL)
  holdExpiresAt   DateTime?         @map("hold_expires_at") @db.Timestamptz(3)
  cancelledAt     DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancelReason    String?           @map("cancel_reason")
  cancelledBy     String?           @map("cancelled_by")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Coluna gerada + constraint de exclusão são adicionadas via SQL manual
  // na migração 20260814094718 (Prisma não modela tstzrange / EXCLUDE
  // nativamente). Declarada como Unsupported para o client saber que ela
  // existe, sem tentar escrevê-la.
  timeRange Unsupported("tstzrange")? @map("time_range")

  client Client? @relation(fields: [clientId], references: [id])
  barber Barber  @relation(fields: [barberId], references: [id])
  items  AppointmentItem[]
  statusHistory AppointmentStatusHistory[]

  @@index([shopId])
  @@index([barberId, startsAt])
  @@index([clientId, startsAt])
  @@index([status, startsAt])
  @@map("appointments")
}

enum ActorType {
  CLIENT
  BARBER
  ADMIN
  SYSTEM
  API
}

// Trilha de auditoria: quem mudou o status de qual agendamento, quando e por quê.
model AppointmentStatusHistory {
  id            String             @id @default(cuid())
  appointmentId String             @map("appointment_id")
  fromStatus    AppointmentStatus? @map("from_status")
  toStatus      AppointmentStatus  @map("to_status")
  actorType     ActorType          @map("actor_type")
  actorId       String?            @map("actor_id")
  reason        String?
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@map("appointment_status_history")
}

model AppointmentItem {
  id             String  @id @default(cuid())
  appointmentId  String  @map("appointment_id")
  serviceId      String  @map("service_id")
  nameSnapshot   String  @map("name_snapshot")
  durationMin    Int     @map("duration_min")
  priceCents     Int     @map("price_cents")
  position       Int     @default(0)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@index([appointmentId])
  @@map("appointment_items")
}

// ---------------------------------------------------------------------------
// Integração — outbox transacional + webhooks (n8n e afins)
// ---------------------------------------------------------------------------

// Padrão outbox: o evento é gravado NA MESMA transação da mudança que o
// originou. Ou os dois existem, ou nenhum — nunca "mudou mas não avisou".
model OutboxEvent {
  id            String    @id @default(cuid())
  shopId        String    @default("default") @map("shop_id")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  payload       Json
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)

  deliveries WebhookDelivery[]

  @@index([shopId, occurredAt])
  @@index([publishedAt])
  @@index([eventType, occurredAt])
  @@map("outbox_events")
}

model WebhookEndpoint {
  id                  String   @id @default(cuid())
  shopId              String   @default("default") @map("shop_id")
  url                 String
  secret              String
  subscribedEvents    String[] @map("subscribed_events")
  active              Boolean  @default(true)
  consecutiveFailures Int      @default(0) @map("consecutive_failures")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  deliveries WebhookDelivery[]

  @@index([shopId])
  @@map("webhook_endpoints")
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
  ABANDONED
}

model WebhookDelivery {
  id                String                @id @default(cuid())
  outboxEventId     String                @map("outbox_event_id")
  webhookEndpointId String                @map("webhook_endpoint_id")
  status            WebhookDeliveryStatus @default(PENDING)
  responseCode      Int?                  @map("response_code")
  attempts          Int                   @default(0)
  nextRetryAt       DateTime              @map("next_retry_at") @db.Timestamptz(3)
  lastAttemptAt     DateTime?             @map("last_attempt_at") @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  outboxEvent     OutboxEvent     @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)
  webhookEndpoint WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([outboxEventId])
  @@map("webhook_deliveries")
}

// ---------------------------------------------------------------------------
// Notificações agendadas + autenticação do portal (OTP)
// ---------------------------------------------------------------------------

enum NotificationChannel {
  WHATSAPP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  CANCELLED
  FAILED
}

// scheduled_for materializa o lembrete como uma linha FUTURA — o worker só
// varre scheduled_for <= now(). "SENT" aqui significa "entregue ao pipeline
// de webhooks" (emitimos um outbox_event notification.due); a confirmação de
// entrega real pelo WhatsApp/e-mail é reportada de volta via PATCH
// /notifications/:id, preenchendo provider_message_id.
model Notification {
  id                String              @id @default(cuid())
  shopId            String              @default("default") @map("shop_id")
  clientId          String?             @map("client_id")
  channel           NotificationChannel
  template          String
  payload           Json
  scheduledFor      DateTime            @map("scheduled_for") @db.Timestamptz(3)
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(3)
  status            NotificationStatus  @default(PENDING)
  providerMessageId String?             @map("provider_message_id")
  dedupKey          String              @unique @map("dedup_key")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  client Client? @relation(fields: [clientId], references: [id])

  @@index([status, scheduledFor])
  @@index([shopId])
  @@map("notifications")
}

// Códigos de uso único para login por telefone. `attempts` limita
// tentativas de adivinhação; `consumedAt` impede reuso do mesmo código.
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  code       String
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@map("otp_codes")
}
